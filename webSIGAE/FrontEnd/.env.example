# Configuración de variables de entorno para Vite (FrontEnd)

# URL base de la API del Backend (en producción o pruebas en Amazon EC2)
# Ejemplo con Nginx/HTTPS: https://sigae.colegiojc.cl/api
# Ejemplo con IP directa: http://54.xxx.xxx.xxx:3000/api
VITE_API_URL=http://localhost:3000/api

# Subruta base si la PWA se aloja en un subdirectorio (ej. GitHub Pages: /sigae-pwa-test/)
# Para raíz o dominio propio, dejar en /
VITE_BASE=/
